    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#241C16"
    },

    {
      "type": "color",
      "id": "note_color",
      "label": "Small note",
      "default": "#AFA39B"
    },

    {
      "type": "range",
      "id": "input_radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Input radius",
      "default": 10
    },

    {
      "type": "range",
      "id": "button_radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Button radius",
      "default": 10
    }

  ],

  "presets": [
    {
      "name": "Studio Zeal Pricing Guide"
    }
  ]
}
{% endschema %}