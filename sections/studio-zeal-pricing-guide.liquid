      "default": "#31251D"
    },

    {
      "type": "color",
      "id": "card_border_color",
      "label": "Form card border",
      "default": "#55473D"
    },

    {
      "type": "color",
      "id": "label_color",
      "label": "Form label",
      "default": "#AFA39B"
    },

    {
      "type": "color",
      "id": "input_background",
      "label": "Input background",
      "default": "#241C16"
    },

    {
      "type": "color",
      "id": "input_border_color",
      "label": "Input border",
      "default": "#61544B"
    },

    {
      "type": "color",
      "id": "focus_border_color",
      "label": "Input focus border",
      "default": "#C99B7A"
    },

    {
      "type": "color",
      "id": "input_text_color",
      "label": "Input text",
      "default": "#FAF6F0"
    },

    {
      "type": "color",
      "id": "placeholder_color",
      "label": "Placeholder text",
      "default": "#A99D95"
    },

    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#FAF6F0"
    },

    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Button hover",
