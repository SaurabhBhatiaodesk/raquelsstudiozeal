{% comment %}
  Studio Zeal Footer
  - Desktop keeps the client layout.
  - Optional logo image; brand-name fallback if no logo.
  - Mobile uses true toggle accordions (one open at a time).
  - Main spacing, typography and colours are configurable in Theme Editor.
  - Uses the theme's page-width container.
{% endcomment %}



<style>
  #StudioZealFooter-{{ section.id }} {
    --sz-bg: {{ section.settings.background_color }};
    --sz-brand: {{ section.settings.brand_color }};
    --sz-link: {{ section.settings.link_color }};
    --sz-hover: {{ section.settings.link_hover_color }};
    --sz-border: {{ section.settings.border_color }};
    --sz-accordion-heading: {{ section.settings.accordion_heading_color }};
    --sz-icon: {{ section.settings.icon_color }};

    margin-top: {{ section.settings.margin_top_desktop }}px;
    border-top: 1px solid var(--sz-border);
    background: var(--sz-bg);
  }

  #StudioZealFooter-{{ section.id }} *,
  #StudioZealFooter-{{ section.id }} *::before,
  #StudioZealFooter-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #StudioZealFooter-{{ section.id }} .studio-zeal-footer__inner {
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    display: flex;
    gap: {{ section.settings.column_gap }}px;
    flex-wrap: wrap;
    align-items: flex-start;
  }

  #StudioZealFooter-{{ section.id }} .studio-zeal-footer__brand-wrap {
    margin-right: auto;
  }

  #StudioZealFooter-{{ section.id }} .studio-zeal-footer__logo {
    display: block;
    width: {{ section.settings.logo_width }}px;
    max-width: 100%;
    height: auto;
  }

  #StudioZealFooter-{{ section.id }} .studio-zeal-footer__brand {
    margin: 0;
    color: var(--sz-brand);
    font-family: 'Cormorant Garamond', serif;
    font-size: {{ section.settings.brand_font_size }}px;
    font-weight: 500;
    line-height: 1;
  }

  #StudioZealFooter-{{ section.id }} .studio-zeal-footer__column {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.link_gap }}px;
    color: var(--sz-link);
    font-family: Karla, sans-serif;
    font-size: {{ section.settings.link_font_size }}px;
    font-weight: 400;
    line-height: 1;
  }

  #StudioZealFooter-{{ section.id }} .studio-zeal-footer__link {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  #StudioZealFooter-{{ section.id }} .studio-zeal-footer__link:hover {
    color: var(--sz-hover);
  }

  #StudioZealFooter-{{ section.id }} .studio-zeal-footer__mobile-menus {
    display: none;
  }

  @media screen and (max-width: 749px) {
    #StudioZealFooter-{{ section.id }} {
      margin-top: {{ section.settings.margin_top_mobile }}px;
    }

    #StudioZealFooter-{{ section.id }} .studio-zeal-footer__inner {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      display: block;
    }

    #StudioZealFooter-{{ section.id }} .studio-zeal-footer__brand-wrap {
      width: 100%;
      margin-right: 0;
      margin-bottom: {{ section.settings.brand_bottom_spacing_mobile }}px;
    }

    #StudioZealFooter-{{ section.id }} .studio-zeal-footer__logo {
      width: {{ section.settings.mobile_logo_width }}px;
    }

    #StudioZealFooter-{{ section.id }} .studio-zeal-footer__desktop-column {
      display: none;
    }

    #StudioZealFooter-{{ section.id }} .studio-zeal-footer__mobile-menus {
      display: block;
      width: 100%;
    }

    #StudioZealFooter-{{ section.id }} .studio-zeal-footer__accordion {
      border-top: 1px solid var(--sz-border);
    }

    #StudioZealFooter-{{ section.id }} .studio-zeal-footer__accordion:last-child {
      border-bottom: 1px solid var(--sz-border);
    }

    #StudioZealFooter-{{ section.id }} .studio-zeal-footer__accordion summary {
      list-style: none;
      cursor: pointer;
      padding-top: {{ section.settings.accordion_padding_vertical }}px;
      padding-bottom: {{ section.settings.accordion_padding_vertical }}px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      color: var(--sz-accordion-heading);
      font-family: Karla, sans-serif;
      font-size: {{ section.settings.accordion_heading_font_size }}px;
      font-weight: 400;
      line-height: 1.2;
      user-select: none;
    }

    #StudioZealFooter-{{ section.id }} .studio-zeal-footer__accordion summary::-webkit-details-marker {
      display: none;
    }

    #StudioZealFooter-{{ section.id }} .studio-zeal-footer__accordion summary::marker {
      display: none;
      content: "";
    }

    #StudioZealFooter-{{ section.id }} .studio-zeal-footer__accordion-icon {
      position: relative;
      width: {{ section.settings.icon_size }}px;
      height: {{ section.settings.icon_size }}px;
      flex: 0 0 {{ section.settings.icon_size }}px;
    }

    #StudioZealFooter-{{ section.id }} .studio-zeal-footer__accordion-icon::before,
    #StudioZealFooter-{{ section.id }} .studio-zeal-footer__accordion-icon::after {
      content: "";
      position: absolute;
      background: var(--sz-icon);
      transition: transform 0.22s ease, opacity 0.22s ease;
    }

    #StudioZealFooter-{{ section.id }} .studio-zeal-footer__accordion-icon::before {
      width: 100%;
      height: 1px;
      left: 0;
      top: 50%;
      transform: translateY(-50%);
    }

    #StudioZealFooter-{{ section.id }} .studio-zeal-footer__accordion-icon::after {
      width: 1px;
      height: 100%;
      left: 50%;
      top: 0;
      transform: translateX(-50%);
    }

    #StudioZealFooter-{{ section.id }} .studio-zeal-footer__accordion[open]
      .studio-zeal-footer__accordion-icon::after {
      transform: translateX(-50%) rotate(90deg);
      opacity: 0;
    }

    #StudioZealFooter-{{ section.id }} .studio-zeal-footer__accordion-content {
      padding: 0 0 {{ section.settings.accordion_content_bottom_padding }}px;
      display: flex;
      flex-direction: column;
      gap: {{ section.settings.mobile_link_gap }}px;
      color: var(--sz-link);
      font-family: Karla, sans-serif;
      font-size: {{ section.settings.mobile_link_font_size }}px;
      font-weight: 400;
      line-height: 1.35;
    }
  }
</style>

<footer id="StudioZealFooter-{{ section.id }}">
  <div class="page-width studio-zeal-footer__inner">

    <div class="studio-zeal-footer__brand-wrap">
      {% if section.settings.logo != blank %}
        {{
          section.settings.logo
          | image_url: width: 600
          | image_tag:
            class: 'studio-zeal-footer__logo',
            loading: 'lazy',
            widths: '120, 180, 240, 360, 480, 600',
            alt: section.settings.logo.alt | default: section.settings.brand_name
        }}
      {% else %}
        <div class="studio-zeal-footer__brand">
          {% if section.settings.brand_name != blank %}
            {{ section.settings.brand_name | escape }}
          {% else %}
            Studio Zeal
          {% endif %}
        </div>
      {% endif %}
    </div>

    <div class="studio-zeal-footer__column studio-zeal-footer__desktop-column">
      {% if section.settings.menu_1 != blank and section.settings.menu_1.links.size > 0 %}
        {% for link in section.settings.menu_1.links %}
          <a
            class="studio-zeal-footer__link"
            href="{{ link.url }}"
            {% if link.current %}aria-current="page"{% endif %}
          >
            {{ link.title | escape }}
          </a>
        {% endfor %}
      {% else %}
        <a class="studio-zeal-footer__link" href="#">Shop the hairline</a>
        <a class="studio-zeal-footer__link" href="#">Hairline powder</a>
        <a class="studio-zeal-footer__link" href="#">Toppers</a>
      {% endif %}
    </div>

    <div class="studio-zeal-footer__column studio-zeal-footer__desktop-column">
      {% if section.settings.menu_2 != blank and section.settings.menu_2.links.size > 0 %}
        {% for link in section.settings.menu_2.links %}
          <a
            class="studio-zeal-footer__link"
            href="{{ link.url }}"
            {% if link.current %}aria-current="page"{% endif %}
          >
            {{ link.title | escape }}
          </a>
        {% endfor %}
      {% else %}
        <a class="studio-zeal-footer__link" href="https://raquelviara.glossgenius.com/book?service_token=1000f-0188dc5c-56f6-4b0e-8921-c0ab0dc968fd">Book a consult</a>
        <a class="studio-zeal-footer__link" href="#">Aftercare</a>
        <a
          class="studio-zeal-footer__link"
          href="https://www.instagram.com/raquels_studiozeal/"
          target="_blank"
          rel="noopener"
        >
          Instagram
        </a>
      {% endif %}
    </div>

    <div class="studio-zeal-footer__mobile-menus">
      <details
        class="studio-zeal-footer__accordion"
        {% if section.settings.first_accordion_open %}open{% endif %}
      >
        <summary>
          <span>{{ section.settings.menu_1_heading | escape }}</span>
          <span class="studio-zeal-footer__accordion-icon" aria-hidden="true"></span>
        </summary>

        <div class="studio-zeal-footer__accordion-content">
          {% if section.settings.menu_1 != blank and section.settings.menu_1.links.size > 0 %}
            {% for link in section.settings.menu_1.links %}
              <a
                class="studio-zeal-footer__link"
                href="{{ link.url }}"
                {% if link.current %}aria-current="page"{% endif %}
              >
                {{ link.title | escape }}
              </a>
            {% endfor %}
          {% else %}
            <a class="studio-zeal-footer__link" href="#">Shop the hairline</a>
            <a class="studio-zeal-footer__link" href="#">Hairline powder</a>
            <a class="studio-zeal-footer__link" href="#">Toppers</a>
          {% endif %}
        </div>
      </details>

      <details class="studio-zeal-footer__accordion">
        <summary>
          <span>{{ section.settings.menu_2_heading | escape }}</span>
          <span class="studio-zeal-footer__accordion-icon" aria-hidden="true"></span>
        </summary>

        <div class="studio-zeal-footer__accordion-content">
          {% if section.settings.menu_2 != blank and section.settings.menu_2.links.size > 0 %}
            {% for link in section.settings.menu_2.links %}
              <a
                class="studio-zeal-footer__link"
                href="{{ link.url }}"
                {% if link.current %}aria-current="page"{% endif %}
              >
                {{ link.title | escape }}
              </a>
            {% endfor %}
          {% else %}
            <a class="studio-zeal-footer__link" href="https://raquelviara.glossgenius.com/book?service_token=1000f-0188dc5c-56f6-4b0e-8921-c0ab0dc968fd">Book a consult</a>
            <a class="studio-zeal-footer__link" href="#">Aftercare</a>
            <a
              class="studio-zeal-footer__link"
              href="https://www.instagram.com/raquels_studiozeal/"
              target="_blank"
              rel="noopener"
            >
              Instagram
            </a>
          {% endif %}
        </div>
      </details>
    </div>

  </div>
</footer>

<script>
  (() => {
    const footer = document.getElementById('StudioZealFooter-{{ section.id }}');
    if (!footer) return;

    const accordions = footer.querySelectorAll('.studio-zeal-footer__accordion');

    accordions.forEach((accordion) => {
      accordion.addEventListener('toggle', () => {
        if (!accordion.open) return;

        accordions.forEach((otherAccordion) => {
          if (otherAccordion !== accordion) {
            otherAccordion.removeAttribute('open');
          }
        });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Studio Zeal Footer",
  "tag": "section",
  "class": "studio-zeal-footer-section",
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name fallback",
      "default": "Studio Zeal",
      "info": "Shown when no logo image is selected."
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Desktop logo width",
      "min": 60,
      "max": 300,
      "step": 5,
      "unit": "px",
      "default": 140
    },
    {
      "type": "range",
      "id": "mobile_logo_width",
      "label": "Mobile logo width",
      "min": 60,
      "max": 240,
      "step": 5,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "brand_font_size",
      "label": "Brand text size",
      "min": 14,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 22
    },

    {
      "type": "header",
      "content": "Menus"
    },
    {
      "type": "text",
      "id": "menu_1_heading",
      "label": "First mobile accordion heading",
      "default": "Shop"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "First menu"
    },
    {
      "type": "text",
      "id": "menu_2_heading",
      "label": "Second mobile accordion heading",
      "default": "Help"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Second menu"
    },
    {
      "type": "checkbox",
      "id": "first_accordion_open",
      "label": "Open first accordion by default",
      "default": false
    },

    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F3EDE4"
    },
    {
      "type": "color",
      "id": "brand_color",
      "label": "Brand text",
      "default": "#241C16"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Links",
      "default": "#5A4E45"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link hover",
      "default": "#241C16"
    },
    {
      "type": "color",
      "id": "accordion_heading_color",
      "label": "Mobile accordion heading",
      "default": "#241C16"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Accordion icon",
      "default": "#241C16"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Borders",
      "default": "#D9D0C6"
    },

    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "margin_top_desktop",
      "label": "Top margin",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 10,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "link_gap",
      "label": "Link gap",
      "min": 4,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 9
    },
    {
      "type": "range",
      "id": "link_font_size",
      "label": "Desktop link size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },

    {
      "type": "header",
      "content": "Mobile spacing & accordion"
    },
    {
      "type": "range",
      "id": "margin_top_mobile",
      "label": "Top margin",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "brand_bottom_spacing_mobile",
