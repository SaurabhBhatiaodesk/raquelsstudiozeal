    {
      "type": "range",
      "id": "icon_size",
      "label": "Plus/minus icon size",
      "min": 10,
      "max": 26,
      "step": 1,
      "unit": "px",
      "default": 14
    }
  ],
  "presets": [
    {
      "name": "Studio Zeal Footer"
    }
  ]
}
{% endschema %}
