{{ 'raquel-coverage.css' | asset_url | stylesheet_tag }}

<section class="rc-collection-intro">
  <div class="rc-wrap">
    <div class="rc-collection-intro__panel">
      <div>
        {% if section.settings.kicker != blank %}
          <p class="rc-kicker">{{ section.settings.kicker }}</p>
        {% endif %}
        <h1 class="rc-editorial__heading">{{ section.settings.heading }}</h1>
      </div>
      <div class="rc-copy">{{ section.settings.text }}</div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Raquel collection intro",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Shop coverage"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Coverage for the places you check first."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Start with the coverage area that bothers you most. These pieces are built for visible thinning, hairline gaps, crown coverage, and confidence in photos.</p>"
    }
  ],
  "presets": [
    {
      "name": "Raquel collection intro"
    }
  ]
}
{% endschema %}
