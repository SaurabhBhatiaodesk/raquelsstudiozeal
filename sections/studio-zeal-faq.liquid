{% comment %}
  Studio Zeal - FAQ
  File: sections/studio-zeal-faq.liquid
{% endcomment %}

<section
  id="studio-zeal-faq-{{ section.id }}"
  class="studio-zeal-faq"
>
  <div class="studio-zeal-faq__container">

    <div class="studio-zeal-faq__heading-wrap">

      {% if section.settings.kicker != blank %}
        <div class="studio-zeal-faq__kicker">
          {{ section.settings.kicker }}
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="studio-zeal-faq__heading">
          {{ section.settings.heading | newline_to_br }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="studio-zeal-faq__intro">
          {{ section.settings.description }}
        </div>
      {% endif %}

    </div>


    {% if section.blocks.size > 0 %}

      <div class="studio-zeal-faq__items">

        {% for block in section.blocks %}

          <details
            class="studio-zeal-faq__item"
            {% if block.settings.open_by_default %}
              open
            {% endif %}
            {{ block.shopify_attributes }}
          >

            <summary class="studio-zeal-faq__question">

              <span class="studio-zeal-faq__question-text">
                {{ block.settings.question }}
              </span>

              <span
                class="studio-zeal-faq__icon"
                aria-hidden="true"
              ></span>

            </summary>


            {% if block.settings.answer != blank %}

              <div class="studio-zeal-faq__answer">
                {{ block.settings.answer }}
              </div>

            {% endif %}

          </details>

        {% endfor %}

      </div>

    {% endif %}

  </div>
</section>


<style>

  /* ==================================
     SECTION
  ================================== */

  #studio-zeal-faq-{{ section.id }} {
    width: 100%;

    background:
      {{ section.settings.background_color }};

    color:
      {{ section.settings.text_color }};
  }


  #studio-zeal-faq-{{ section.id }} *,
  #studio-zeal-faq-{{ section.id }} *::before,
  #studio-zeal-faq-{{ section.id }} *::after {
    box-sizing: border-box;
  }


  /* ==================================
     CONTAINER
  ================================== */

  #studio-zeal-faq-{{ section.id }}
  .studio-zeal-faq__container {

    width: 100%;

    max-width:
      {{ section.settings.container_width }}px;

    margin: 0 auto;

    padding:
      {{ section.settings.padding_top }}px
      36px
      {{ section.settings.padding_bottom }}px;

    display: grid;

    grid-template-columns:
      {{ section.settings.heading_column_width }}px
      minmax(0, 1fr);

    align-items: start;

    gap:
      {{ section.settings.column_gap }}px;
  }


  /* ==================================
     LEFT CONTENT
  ================================== */

  #studio-zeal-faq-{{ section.id }}
  .studio-zeal-faq__heading-wrap {

    width: 100%;
  }


  #studio-zeal-faq-{{ section.id }}
  .studio-zeal-faq__kicker {

    margin-bottom: 16px;

    color:
      {{ section.settings.accent_color }};

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 10px;

    font-weight: 500;

    line-height: 1;

    letter-spacing: 0.2em;

    text-transform: uppercase;
  }


  #studio-zeal-faq-{{ section.id }}
  .studio-zeal-faq__heading {

    margin: 0;

    color:
      {{ section.settings.text_color }};

    font-family:
      "Cormorant Garamond",
      Georgia,
      serif;

    font-size:
      {{ section.settings.heading_size }}px;

    font-weight: 500;

    line-height: 1.1;

    letter-spacing: -0.01em;
  }


  #studio-zeal-faq-{{ section.id }}
  .studio-zeal-faq__intro {

    max-width: 300px;

    margin-top: 18px;

    color:
      {{ section.settings.secondary_text_color }};

    font-size: 15px;

    font-weight: 300;

    line-height: 1.6;
  }


  #studio-zeal-faq-{{ section.id }}
  .studio-zeal-faq__intro p {

    margin: 0;
  }


  /* ==================================
     FAQ ITEMS
  ================================== */

  #studio-zeal-faq-{{ section.id }}
  .studio-zeal-faq__items {

    width: 100%;

    border-bottom:
      1px solid
      {{ section.settings.border_color }};
  }


  #studio-zeal-faq-{{ section.id }}
  .studio-zeal-faq__item {

    width: 100%;

    margin: 0;

    padding:
      {{ section.settings.item_padding }}px
      0;

    border-top:
      1px solid
      {{ section.settings.border_color }};
  }


  /* Remove native marker */

  #studio-zeal-faq-{{ section.id }}
  .studio-zeal-faq__question {

    list-style: none;

    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      auto;

    align-items: center;

    gap: 24px;

    margin: 0;

    padding: 0;

    color:
      {{ section.settings.text_color }};

    cursor: pointer;

    font-size:
      {{ section.settings.question_size }}px;

    font-weight: 400;

    line-height: 1.4;
  }


  #studio-zeal-faq-{{ section.id }}
  .studio-zeal-faq__question::-webkit-details-marker {

    display: none;
  }


  #studio-zeal-faq-{{ section.id }}
  .studio-zeal-faq__question::marker {

    display: none;
    content: "";
  }


  /* ==================================
     PLUS / MINUS

     No absolute positioning.
  ================================== */

  #studio-zeal-faq-{{ section.id }}
  .studio-zeal-faq__icon {

    width: 28px;
    height: 28px;

    display: grid;

    place-items: center;

    flex: none;

    color:
      {{ section.settings.accent_color }};

    font-size: 24px;

    font-weight: 300;

    line-height: 1;
  }


  #studio-zeal-faq-{{ section.id }}
  .studio-zeal-faq__icon::before {

    content: "+";
  }


  #studio-zeal-faq-{{ section.id }}
  .studio-zeal-faq__item[open]
  .studio-zeal-faq__icon::before {

    content: "−";
  }


  /* ==================================
     ANSWER
  ================================== */

  #studio-zeal-faq-{{ section.id }}
  .studio-zeal-faq__answer {

    max-width:
      {{ section.settings.answer_width }}px;

    padding-top:
      {{ section.settings.answer_spacing }}px;

    color:
      {{ section.settings.secondary_text_color }};

    font-size:
      {{ section.settings.answer_size }}px;

    font-weight: 300;

    line-height: 1.65;
  }


  #studio-zeal-faq-{{ section.id }}
  .studio-zeal-faq__answer p {

    margin: 0 0 12px;
  }


  #studio-zeal-faq-{{ section.id }}
  .studio-zeal-faq__answer p:last-child {

    margin-bottom: 0;
  }


  /* ==================================
     QUESTION HOVER
  ================================== */

  #studio-zeal-faq-{{ section.id }}
  .studio-zeal-faq__question-text {

    transition:
      color 0.25s ease;
  }


  #studio-zeal-faq-{{ section.id }}
  .studio-zeal-faq__question:hover
  .studio-zeal-faq__question-text {

    color:
      {{ section.settings.hover_color }};
  }


  /* ==================================
     TABLET
  ================================== */

  @media screen and (max-width: 990px) {

    #studio-zeal-faq-{{ section.id }}
    .studio-zeal-faq__container {

      padding-left: 28px;
      padding-right: 28px;

      grid-template-columns:
        280px
        minmax(0, 1fr);

      gap: 42px;
    }


    #studio-zeal-faq-{{ section.id }}
    .studio-zeal-faq__heading {

      font-size: 34px;
    }


    #studio-zeal-faq-{{ section.id }}
    .studio-zeal-faq__question {

      font-size: 18px;
    }

  }


  /* ==================================
     MOBILE
  ================================== */

  @media screen and (max-width: 749px) {

    #studio-zeal-faq-{{ section.id }}
    .studio-zeal-faq__container {

      padding:
        {{ section.settings.mobile_padding_top }}px
        20px
        {{ section.settings.mobile_padding_bottom }}px;

      grid-template-columns: 1fr;

      gap: 34px;
    }


    #studio-zeal-faq-{{ section.id }}
    .studio-zeal-faq__heading {

      max-width: 330px;

      font-size:
        {{ section.settings.mobile_heading_size }}px;
    }


    #studio-zeal-faq-{{ section.id }}
    .studio-zeal-faq__intro {

      max-width: 100%;
    }


    #studio-zeal-faq-{{ section.id }}
    .studio-zeal-faq__item {

      padding:
        {{ section.settings.mobile_item_padding }}px
        0;
    }


    #studio-zeal-faq-{{ section.id }}
    .studio-zeal-faq__question {

      gap: 18px;

      font-size:
        {{ section.settings.mobile_question_size }}px;
    }


    #studio-zeal-faq-{{ section.id }}
    .studio-zeal-faq__answer {

      max-width: 100%;

      font-size:
        {{ section.settings.mobile_answer_size }}px;
    }

  }

</style>


{% schema %}
{
  "name": "Studio Zeal FAQ",
  "tag": "section",
  "class": "studio-zeal-faq-section",

  "settings": [

    {
      "type": "header",
      "content": "Heading"
    },

    {
      "type": "text",
      "id": "kicker",
      "label": "Small heading"
    },

    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Questions we get\non every call"
    },

    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },


    {
      "type": "header",
      "content": "Layout"
    },

    {
      "type": "range",
      "id": "container_width",
      "min": 1000,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "label": "Container width",
      "default": 1240
    },

    {
      "type": "range",
      "id": "heading_column_width",
      "min": 250,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Heading column width",
      "default": 340
    },

    {
      "type": "range",
      "id": "column_gap",
      "min": 20,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Column gap",
      "default": 56
    },

    {
      "type": "range",
      "id": "answer_width",
      "min": 400,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "Answer max width",
      "default": 560
    },


    {
      "type": "header",
      "content": "Typography"
    },

    {
      "type": "range",
      "id": "heading_size",
      "min": 28,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Desktop heading",
      "default": 38
    },

    {
      "type": "range",
      "id": "mobile_heading_size",
      "min": 26,
      "max": 44,
      "step": 1,
      "unit": "px",
      "label": "Mobile heading",
      "default": 32
    },

    {
      "type": "range",
      "id": "question_size",
      "min": 15,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Question size",
      "default": 19
    },

    {
      "type": "range",
      "id": "mobile_question_size",
      "min": 15,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Mobile question",
      "default": 17
    },

    {
      "type": "range",
      "id": "answer_size",
      "min": 13,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Answer size",
      "default": 16
    },

    {
      "type": "range",
      "id": "mobile_answer_size",
      "min": 13,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Mobile answer",
      "default": 15
    },


    {
      "type": "header",
      "content": "Spacing"
    },

    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Desktop top padding",
      "default": 84
    },

    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Desktop bottom padding",
      "default": 0
    },

    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Mobile top padding",
      "default": 60
    },

    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Mobile bottom padding",
      "default": 0
    },

    {
      "type": "range",
      "id": "item_padding",
      "min": 12,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "FAQ item padding",
      "default": 20
    },

    {
      "type": "range",
      "id": "mobile_item_padding",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Mobile item padding",
      "default": 18
    },

    {
      "type": "range",
      "id": "answer_spacing",
      "min": 6,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Question/answer gap",
      "default": 14
    },


    {
      "type": "header",
      "content": "Colors"
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FAF6F0"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Question / Heading",
      "default": "#241C16"
    },

    {
      "type": "color",
      "id": "secondary_text_color",
      "label": "Answer text",
      "default": "#5A4E45"
    },

    {
      "type": "color",
      "id": "accent_color",
      "label": "Plus / minus",
      "default": "#8C6357"
    },

    {
      "type": "color",
      "id": "hover_color",
      "label": "Question hover",
      "default": "#8C6357"
    },

    {
      "type": "color",
      "id": "border_color",
      "label": "Divider",
      "default": "#DED5CC"
    }

  ],


  "blocks": [

    {
      "type": "faq",
      "name": "FAQ",

      "settings": [

        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Will it look obvious?"
        },

        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>The lace is hand-tied and sits flat under a headband, and we blend the part with hairline powder at your fitting. Most clients wear theirs to work the same day.</p>"
        },

        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "Open by default",
          "default": false
        }

      ]

    }

  ],


  "presets": [

    {
      "name": "Studio Zeal FAQ",

      "blocks": [

        {
          "type": "faq",
          "settings": {
            "question": "Will it look obvious?",
            "answer": "<p>The lace is hand-tied and sits flat under a headband, and we blend the part with hairline powder at your fitting. Most clients wear theirs to work the same day.</p>",
            "open_by_default": true
          }
        },

        {
          "type": "faq",
          "settings": {
            "question": "Why do I need a consult before buying?",
            "answer": "<p>Color is the whole game at this price. Fifteen minutes on video saves a return, and it tells us whether a hairline, a topper or just the powder is right for you.</p>",
            "open_by_default": false
          }
        },

        {
          "type": "faq",
          "settings": {
            "question": "Does it come in curly or wavy?",
            "answer": "<p>It arrives straight and can be permed to match your texture. We talk through that on the call.</p>",
            "open_by_default": false
          }
        },

        {
          "type": "faq",
          "settings": {
            "question": "How long does a set last?",
            "answer": "<p>With the aftercare we show you, a Remy set holds its color and shine for months of regular wear and tangles far less than synthetic alternatives.</p>",
            "open_by_default": false
          }
        }

      ]

    }

  ]

}
{% endschema %}