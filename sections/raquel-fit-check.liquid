<section class="sz-section sz-fit color-{{ section.settings.color_scheme }}" aria-labelledby="FitHeading-{{ section.id }}">
  <div class="sz-wrap">
    <header class="sz-section-header sz-section-header--center">
      {% if section.settings.eyebrow != blank %}<p class="sz-eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      <h2 id="FitHeading-{{ section.id }}" class="sz-heading">{{ section.settings.heading }}</h2>
    </header>
    <div class="sz-fit__grid">
      <article class="sz-fit-card sz-fit-card--yes">
        <h3>{{ section.settings.yes_heading }}</h3>
        <ul role="list">{% for block in section.blocks %}{% if block.type == 'yes' %}<li {{ block.shopify_attributes }}><span aria-hidden="true">✓</span>{{ block.settings.text }}</li>{% endif %}{% endfor %}</ul>
      </article>
      <article class="sz-fit-card sz-fit-card--no">
        <h3>{{ section.settings.no_heading }}</h3>
        <ul role="list">{% for block in section.blocks %}{% if block.type == 'no' %}<li {{ block.shopify_attributes }}><span aria-hidden="true">×</span>{{ block.settings.text }}</li>{% endif %}{% endfor %}</ul>
      </article>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Studio Zeal fit check",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-5" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Is this right for you?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Know before you buy." },
    { "type": "text", "id": "yes_heading", "label": "For you heading", "default": "This is for you if..." },
    { "type": "text", "id": "no_heading", "label": "Not for you heading", "default": "This is not for you if..." }
  ],
  "blocks": [
    { "type": "yes", "name": "For you item", "limit": 7, "settings": [{ "type": "textarea", "id": "text", "label": "Text", "default": "Your hairline, temples, or part line is where thinning shows most" }] },
    { "type": "no", "name": "Not for you item", "limit": 5, "settings": [{ "type": "textarea", "id": "text", "label": "Text", "default": "You are looking for a quick fix with overnight miracle claims" }] }
  ],
  "presets": [{ "name": "Studio Zeal fit check", "blocks": [{ "type": "yes" }, { "type": "yes" }, { "type": "no" }] }]
}
{% endschema %}
