{% comment %}
  Studio Zeal Hairline CTA
  Clean Shopify section.
  Same client design, using the theme's existing page-width class.
  No !important rules.
{% endcomment %}



<style>
  #StudioZealCTA-{{ section.id }} {
    margin-top: 84px;
  }

  #StudioZealCTA-{{ section.id }} *,
  #StudioZealCTA-{{ section.id }} *::before,
  #StudioZealCTA-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #StudioZealCTA-{{ section.id }} .studio-zeal-cta__box {
    width: 100%;
    padding: 66px 48px;
    border-radius: 20px;
    background: {{ section.settings.background_color }};
    text-align: center;
  }

  #StudioZealCTA-{{ section.id }} .studio-zeal-cta__heading {
    margin: 0 0 14px;
    padding: 0;
    color: {{ section.settings.heading_color }};
    font-family: 'Cormorant Garamond', serif;
    font-size: 46px;
    font-style: normal;
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: 0;
    text-transform: none;
  }

  #StudioZealCTA-{{ section.id }} .studio-zeal-cta__text {
    max-width: 480px;
    margin: 0 auto 30px;
    padding: 0;
    color: {{ section.settings.text_color }};
    font-family: Karla, sans-serif;
    font-size: 17px;
    font-style: normal;
    font-weight: 300;
    line-height: 1.6;
    letter-spacing: 0;
  }

  #StudioZealCTA-{{ section.id }} .studio-zeal-cta__text p {
    margin: 0;
    padding: 0;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
  }

  #StudioZealCTA-{{ section.id }} .studio-zeal-cta__buttons {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  #StudioZealCTA-{{ section.id }} a.studio-zeal-cta__button,
  #StudioZealCTA-{{ section.id }} a.studio-zeal-cta__button:link,
  #StudioZealCTA-{{ section.id }} a.studio-zeal-cta__button:visited {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: auto;
    min-width: 0;
    min-height: 0;
    height: auto;
    margin: 0;
    border-radius: 999px;
    box-shadow: none;
    font-family: Karla, sans-serif;
    font-size: 15px;
    font-style: normal;
    line-height: 1;
    letter-spacing: 0;
    text-decoration: none;
    text-transform: none;
  }

  #StudioZealCTA-{{ section.id }} a.studio-zeal-cta__button--primary,
  #StudioZealCTA-{{ section.id }} a.studio-zeal-cta__button--primary:link,
  #StudioZealCTA-{{ section.id }} a.studio-zeal-cta__button--primary:visited {
    padding: 18px 32px;
    border: 1px solid {{ section.settings.primary_button_bg }};
    background: {{ section.settings.primary_button_bg }};
    color: {{ section.settings.primary_button_text }};
    font-weight: 500;
  }

  #StudioZealCTA-{{ section.id }} a.studio-zeal-cta__button--primary:hover,
  #StudioZealCTA-{{ section.id }} a.studio-zeal-cta__button--primary:focus {
    border-color: {{ section.settings.primary_button_hover_bg }};
    background: {{ section.settings.primary_button_hover_bg }};
    color: {{ section.settings.primary_button_text }};
  }

  #StudioZealCTA-{{ section.id }} a.studio-zeal-cta__button--secondary,
  #StudioZealCTA-{{ section.id }} a.studio-zeal-cta__button--secondary:link,
  #StudioZealCTA-{{ section.id }} a.studio-zeal-cta__button--secondary:visited {
    padding: 18px 28px;
    border: 1px solid rgba(36, 28, 22, 0.3);
    background: transparent;
    color: {{ section.settings.secondary_button_text }};
    font-weight: 400;
  }

  #StudioZealCTA-{{ section.id }} a.studio-zeal-cta__button--secondary:hover,
  #StudioZealCTA-{{ section.id }} a.studio-zeal-cta__button--secondary:focus {
    border-color: {{ section.settings.secondary_button_hover_border }};
    background: transparent;
    color: {{ section.settings.secondary_button_text }};
  }


  #StudioZealCTA-{{ section.id }} .studio-zeal-cta__subheading {
    margin:15px 0 0 0px;
    color: {{ section.settings.sub_heading_color }};
    font-family: Karla, sans-serif;
    font-size: 14.5px;
    font-weight: 400;
    line-height: 1.5;
  }
  #StudioZealCTA-{{ section.id }} .studio-zeal-cta__subheading a{
    color: {{ section.settings.sub_heading_color }};
    text-underline-offset: 6px;
    text-decoration-color: #faf6f073;
  }

  #StudioZealCTA-{{ section.id }} .studio-zeal-cta__subheading p {
    margin: 0;
  }


  @media screen and (max-width: 749px) {
    #StudioZealCTA-{{ section.id }} {
      margin-top: 56px;
    }

    #StudioZealCTA-{{ section.id }} .studio-zeal-cta__box {
      padding: 44px 22px;
      border-radius: 16px;
    }

    #StudioZealCTA-{{ section.id }} .studio-zeal-cta__heading {
      font-size: 36px;
    }

    #StudioZealCTA-{{ section.id }} .studio-zeal-cta__text {
      margin-bottom: 24px;
      font-size: 16px;
    }

    #StudioZealCTA-{{ section.id }} .studio-zeal-cta__buttons {
      gap: 10px;
    }
  }
</style>

<section id="StudioZealCTA-{{ section.id }}">
  <div class="page-width">
    <div class="studio-zeal-cta__box">

      {% if section.settings.heading != blank %}
        <h2 class="studio-zeal-cta__heading">
          {{ section.settings.heading | escape }}
        </h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="studio-zeal-cta__text">
          {{ section.settings.text }}
        </div>
      {% endif %}

      {% if section.settings.primary_button_label != blank or section.settings.secondary_button_label != blank %}
        <div class="studio-zeal-cta__buttons">

          {% if section.settings.primary_button_label != blank %}
            <a
              href="{{ section.settings.primary_button_link | default: '#' }}"
              class="studio-zeal-cta__button studio-zeal-cta__button--primary"
            >
              {{ section.settings.primary_button_label | escape }}
            </a>
          {% endif %}

          {% if section.settings.secondary_button_label != blank %}
            <a
              href="{{ section.settings.secondary_button_link | default: '#' }}"
              class="studio-zeal-cta__button studio-zeal-cta__button--secondary"
            >
              {{ section.settings.secondary_button_label | escape }}
            </a>
          {% endif %}

        </div>
      {% endif %}

      {% if section.settings.sub_heading != blank %}
        <div class="studio-zeal-cta__subheading">
          {{ section.settings.sub_heading }}
        </div>
      {% endif %}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Studio Zeal Hairline CTA",
  "tag": "section",
  "class": "studio-zeal-hairline-cta-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Let's look at your hairline together"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Fifteen minutes, free, no pressure to buy. Pick a time that works and Raquel will call you.</p>"
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Primary button label",
      "default": "Book now"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary button label",
      "default": "Get the guide instead"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#EFE4D6"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#241C16"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#4A403A"
    },
    {
      "type": "color",
      "id": "primary_button_bg",
      "label": "Primary button background",
      "default": "#241C16"
    },
    {
      "type": "color",
      "id": "primary_button_text",
      "label": "Primary button text",
      "default": "#FAF6F0"
    },
    {
      "type": "color",
      "id": "primary_button_hover_bg",
      "label": "Primary button hover",
      "default": "#3D2E24"
    },
    {
      "type": "color",
      "id": "secondary_button_text",
      "label": "Secondary button text",
      "default": "#241C16"
    },
    {
      "type": "color",
      "id": "secondary_button_hover_border",
      "label": "Secondary button hover border",
      "default": "#241C16"
    },
    {
      "type": "richtext",
      "id": "sub_heading",
      "label": "Sub Heading",
      "default": "<p>Book your free consultation today</p>"
    },
    {
      "type": "color",
      "id": "sub_heading_color",
      "label": "Sub Heading Color",
      "default": "#4A403A"
    },
  ],
  "presets": [
    {
      "name": "Studio Zeal Hairline CTA"
    }
  ]
}
{% endschema %}
