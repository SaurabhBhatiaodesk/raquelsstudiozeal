{% comment %}
  Studio Zeal - Social Reels
  File: sections/studio-zeal-social-reels.liquid
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500&family=Karla:wght@300;400;500&display=swap" rel="stylesheet">

<section
  id="studio-zeal-reels-{{ section.id }}"
  class="studio-zeal-reels"
>
  <div class="page-width studio-zeal-reels__container">

    {% if section.settings.heading != blank
      or section.settings.instagram_text != blank
    %}
      <div class="studio-zeal-reels__header">

        {% if section.settings.heading != blank %}
          <h2 class="studio-zeal-reels__heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.instagram_text != blank %}
          <a
            class="studio-zeal-reels__instagram"
            href="{{ section.settings.instagram_url | default: '#' }}"
            {% if section.settings.instagram_url != blank %}
              target="_blank"
              rel="noopener"
            {% endif %}
          >
            {{ section.settings.instagram_text }}
            <span aria-hidden="true">→</span>
          </a>
        {% endif %}

      </div>
    {% endif %}


    {% if section.blocks.size > 0 %}
      <div class="studio-zeal-reels__grid">

        {% for block in section.blocks %}

          {% if block.type == 'reel' %}

            <div
              class="studio-zeal-reels__card"
              {{ block.shopify_attributes }}
            >

              {% if block.settings.reel_id != blank %}

                <iframe
                  class="studio-zeal-reels__iframe"
                  src="https://www.instagram.com/reel/{{ block.settings.reel_id | strip }}/embed/"
                  title="{{ block.settings.accessibility_title | default: 'Studio Zeal Instagram reel' | escape }}"
                  loading="lazy"
                  scrolling="yes"
                  allowtransparency="true"
                  allowfullscreen="true"
                ></iframe>

              {% elsif block.settings.placeholder_image != blank %}

                <div class="studio-zeal-reels__image-wrap">

                  {{
                    block.settings.placeholder_image
                    | image_url: width: 900
                    | image_tag:
                      class: 'studio-zeal-reels__image',
                      loading: 'lazy',
                      widths: '400, 600, 900',
                      sizes: '(max-width: 749px) 85vw, (max-width: 990px) 45vw, 33vw'
                  }}

                </div>

              {% else %}

                <div class="studio-zeal-reels__placeholder">
                  {{ 'image' | placeholder_svg_tag }}
                </div>

              {% endif %}

            </div>

          {% endif %}

        {% endfor %}

      </div>
    {% endif %}

  </div>
</section>


<style>

  /* ==================================
     SECTION
  ================================== */

  #studio-zeal-reels-{{ section.id }} {
    width: 100%;

    background:
      {{ section.settings.background_color }};

    color:
      {{ section.settings.text_color }};
  }


  #studio-zeal-reels-{{ section.id }} *,
  #studio-zeal-reels-{{ section.id }} *::before,
  #studio-zeal-reels-{{ section.id }} *::after {
    box-sizing: border-box;
  }


  /* ==================================
     CONTAINER
  ================================== */

  #studio-zeal-reels-{{ section.id }}
  .studio-zeal-reels__container {

    width: 100%;

    margin: 0 auto;

    padding-top:
      {{ section.settings.padding_top }}px;

    padding-bottom:
      {{ section.settings.padding_bottom }}px;
  }


  /* ==================================
     HEADER
  ================================== */

  #studio-zeal-reels-{{ section.id }}
  .studio-zeal-reels__header {

    display: flex;

    align-items: baseline;

    justify-content: space-between;

    gap: 30px;

    margin-bottom:
      {{ section.settings.heading_bottom_spacing }}px;
  }


  #studio-zeal-reels-{{ section.id }}
  .studio-zeal-reels__heading {

    margin: 0;

    color:
      {{ section.settings.text_color }};

    font-family:
      "Cormorant Garamond",
      Georgia,
      serif;

    font-size: 38px;

    font-weight: 500;

    line-height: 1.1;

    letter-spacing: -0.01em;
  }


  /* Instagram link */

  #studio-zeal-reels-{{ section.id }}
  .studio-zeal-reels__instagram {

    flex: none;

    display: inline-flex;

    align-items: center;

    gap: 5px;

    padding-bottom: 3px;

    border-bottom:
      1px solid
      {{ section.settings.link_border_color }};

    color:
      {{ section.settings.link_color }};

    font-family: Karla, sans-serif;
    font-size: 14px;

    font-weight: 400;

    line-height: 1.2;

    text-decoration: none;

    transition:
      color 0.25s ease,
      border-color 0.25s ease;
  }


  #studio-zeal-reels-{{ section.id }}
  .studio-zeal-reels__instagram:hover {

    color:
      {{ section.settings.link_hover_color }};

    border-bottom-color:
      {{ section.settings.link_hover_color }};
  }


  /* ==================================
     REELS GRID

     Pure CSS Grid.
     No absolute positioning.
  ================================== */

  #studio-zeal-reels-{{ section.id }}
  .studio-zeal-reels__grid {

    display: grid;

    grid-template-columns:
      repeat({{ section.settings.desktop_columns }}, minmax(0, 1fr));

    gap:
      {{ section.settings.card_gap }}px;
  }


  /* ==================================
     REEL CARD
  ================================== */

  #studio-zeal-reels-{{ section.id }}
  .studio-zeal-reels__card {

    width: 100%;

    aspect-ratio: {{ section.settings.aspect_ratio }};

    overflow: hidden;

    height: 476px;

    border:
      1px solid
      {{ section.settings.card_border_color }};

    border-radius:
      {{ section.settings.card_radius }}px;

    background:
      {{ section.settings.card_background }};

    font-family: Karla, sans-serif;

    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }


  {% if section.settings.enable_card_hover %}
    #studio-zeal-reels-{{ section.id }}
    .studio-zeal-reels__card:hover {

      transform: translateY(-4px);

      box-shadow:
        0 18px 40px
        rgba(36, 28, 22, 0.10);
    }
  {% endif %}


  /* ==================================
     INSTAGRAM IFRAME
  ================================== */

  #studio-zeal-reels-{{ section.id }}
  .studio-zeal-reels__iframe {

    width: 100%;

    height: 100%;

    min-height: 476px;

    display: block;

    margin: 0;

    padding: 0;

    border: 0;

    overflow: auto;

    background: #ffffff;
  }


  /* ==================================
     IMAGE FALLBACK
  ================================== */

  #studio-zeal-reels-{{ section.id }}
  .studio-zeal-reels__image-wrap,

  #studio-zeal-reels-{{ section.id }}
  .studio-zeal-reels__placeholder {

    width: 100%;

    height: 100%;
  }


  #studio-zeal-reels-{{ section.id }}
  .studio-zeal-reels__image {

    width: 100%;

    height: 100%;

    display: block;

    object-fit: cover;
  }


  #studio-zeal-reels-{{ section.id }}
  .studio-zeal-reels__placeholder svg {

    width: 100%;

    height: 100%;

    display: block;

    object-fit: cover;
  }


  /* ==================================
     TABLET
  ================================== */

  @media screen and (max-width: 990px) {

    #studio-zeal-reels-{{ section.id }}
    .studio-zeal-reels__container {

      padding-left: 28px;
      padding-right: 28px;
    }


    #studio-zeal-reels-{{ section.id }}
    .studio-zeal-reels__grid {

      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }


    #studio-zeal-reels-{{ section.id }}
    .studio-zeal-reels__card {

      height: 500px;
    }

  }


  /* ==================================
     MOBILE
  ================================== */

  @media screen and (max-width: 749px) {

    #studio-zeal-reels-{{ section.id }}
    .studio-zeal-reels__container {

      padding:
        {{ section.settings.mobile_padding_top }}px
        20px
        {{ section.settings.mobile_padding_bottom }}px;
    }


    #studio-zeal-reels-{{ section.id }}
    .studio-zeal-reels__header {

      align-items: flex-start;

      flex-direction: column;

      gap: 14px;

      margin-bottom: 24px;
    }


    #studio-zeal-reels-{{ section.id }}
    .studio-zeal-reels__heading {

      font-size: 34px;
    }


    #studio-zeal-reels-{{ section.id }}
    .studio-zeal-reels__grid {

      grid-template-columns: 1fr;

      gap: 18px;

      overflow: visible;
    }


    #studio-zeal-reels-{{ section.id }}
    .studio-zeal-reels__card {

      width: 100%;

      aspect-ratio: {{ section.settings.aspect_ratio }};
    }

  }

</style>



<script>
document.addEventListener("DOMContentLoaded", function(){
  const reels = document.querySelectorAll(
    "#studio-zeal-reels-{{ section.id }} iframe"
  );

  reels.forEach(function(reel){
    reel.onload = function(){
      setInterval(function(){
        try {
          reel.contentWindow.scrollBy({
            top: 1,
            behavior: "smooth"
          });
        } catch(e){}
      }, 50);
    }
  });
});
</script>

{% schema %}
{
  "name": "Studio Zeal Reels",
  "tag": "section",
  "class": "studio-zeal-reels-section",

  "settings": [

    {
      "type": "header",
      "content": "Heading"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See why everyone's talking about it"
    },

    {
      "type": "text",
      "id": "instagram_text",
      "label": "Instagram link text",
      "default": "@raquels_studiozeal"
    },

    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram profile link"
    },


    {
      "type": "header",
      "content": "Layout"
    },

    {
      "type": "range",
      "id": "desktop_columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Desktop columns",
      "default": 3
    },

    {
      "type": "range",
      "id": "card_gap",
      "min": 8,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Card gap",
      "default": 20
    },



    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Card radius",
      "default": 14
    },

    {
      "type": "checkbox",
      "id": "enable_card_hover",
      "label": "Enable card hover",
      "default": false
    },


    {
      "type": "header",
      "content": "Typography"
    },

    {
      "type": "range",
      "id": "heading_size",
      "min": 28,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Desktop heading size",
      "default": 38
    },

    {
      "type": "range",
      "id": "mobile_heading_size",
      "min": 26,
      "max": 44,
      "step": 1,
      "unit": "px",
      "label": "Mobile heading size",
      "default": 32
    },

    {
      "type": "range",
      "id": "heading_bottom_spacing",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading bottom spacing",
      "default": 26
    },


    {
      "type": "header",
      "content": "Spacing"
    },

    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Desktop top padding",
      "default": 84
    },

    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Desktop bottom padding",
      "default": 0
    },

    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Mobile top padding",
      "default": 60
    },

    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Mobile bottom padding",
      "default": 0
    },


    {
      "type": "header",
      "content": "Colors"
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FAF6F0"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Heading",
      "default": "#241C16"
    },

    {
      "type": "color",
      "id": "link_color",
      "label": "Instagram link",
      "default": "#8C6357"
    },

    {
      "type": "color",
      "id": "link_border_color",
      "label": "Link underline",
      "default": "#C9AAA1"
    },

    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link hover",
      "default": "#241C16"
    },

    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#FFFFFF"
    },

    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border",
      "default": "#DDD5CD"
    },

    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Reel aspect ratio",
      "default": "9 / 16",
      "options": [
        {
          "value": "16 / 9",
          "label": "Landscape"
        },
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "9 / 16",
          "label": "Portrait"
        }
      ]
    }

  ],


  "blocks": [

    {
      "type": "reel",
      "name": "Instagram Reel",

      "settings": [

        {
          "type": "text",
          "id": "reel_id",
          "label": "Instagram Reel ID",
          "info": "Example: DYngn0yBJr_"
        },

        {
          "type": "text",
          "id": "accessibility_title",
          "label": "Reel title",
          "default": "Studio Zeal Instagram reel"
        },

        {
          "type": "image_picker",
          "id": "placeholder_image",
          "label": "Fallback image"
        }

      ]
    }

  ],

  "presets": [

    {
      "name": "Studio Zeal Reels",

      "blocks": [

        {
          "type": "reel",
          "settings": {
            "reel_id": "DYngn0yBJr_",
            "accessibility_title": "Studio Zeal reel one"
          }
        },

        {
          "type": "reel",
          "settings": {
            "reel_id": "DbEOOL9PZmm",
            "accessibility_title": "Studio Zeal reel two"
          }
        },

        {
          "type": "reel",
          "settings": {
            "reel_id": "DaBtjd8vB-l",
            "accessibility_title": "Studio Zeal reel three"
          }
        }

      ]

    }

  ]

}
{% endschema %}