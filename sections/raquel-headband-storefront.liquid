      "type": "text",
      "id": "powder_price",
      "label": "Powder fallback price",
      "default": "$24.93"
    },
    {
      "type": "text",
      "id": "powder_button",
      "label": "Powder button",
      "default": "Shop powder"
    },
    {
      "type": "text",
      "id": "guide_kicker",
      "label": "Guide kicker",
      "default": "How to buy"
