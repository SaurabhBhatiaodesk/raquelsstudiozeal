    },
    {
      "type": "text",
      "id": "headband_eyebrow",
      "label": "Headband eyebrow",
      "default": "Hero coverage"
    },
    {
      "type": "text",
      "id": "headband_title",
      "label": "Headband title",
      "default": "Hairline Headband"
    },
    {
      "type": "textarea",
      "id": "headband_description",
      "label": "Headband description",
      "default": "A fully engineered 360-degree hairline enhancement system that refines the perimeter, adds fullness, and creates a natural transition where traditional extensions cannot safely anchor."
    },
    {
      "type": "text",
      "id": "headband_price",
      "label": "Headband fallback price",
      "default": "$725.92"
    },
    {
      "type": "text",
      "id": "headband_button",
      "label": "Headband button",
      "default": "Choose shade"
    },
    {
      "type": "text",
      "id": "powder_handle",
      "label": "Powder product handle",
      "default": "colored-hairline-powder"
    },
    {
      "type": "url",
      "id": "powder_fallback_link",
      "label": "Powder fallback link"
    },
    {
      "type": "text",
      "id": "powder_image_url",
      "label": "Powder fallback image URL",
      "default": "https://hairlosophy.com/media/catalog/product/cache/6517c62f5899ad6aa0ba23ceb3eeff97/h/a/hairlosophy-powder-group.jpg"
    },
    {
      "type": "text",
      "id": "powder_image_alt",
      "label": "Powder image alt text",
      "default": "Hairlosophy Colored Hairline Powder shade range"
    },
    {
      "type": "text",
      "id": "powder_eyebrow",
      "label": "Powder eyebrow",
      "default": "Finishing companion"
    },
    {
      "type": "text",
      "id": "powder_title",
      "label": "Powder title",
      "default": "Colored Hairline Powder"
