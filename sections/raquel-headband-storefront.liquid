  ],
  "presets": [
    {
      "name": "Raquel headband store",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Start with the hairline",
            "text": "Choose the Headband Hairline when the front perimeter, temples, or pulled-back styles are where thinning shows most."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Match the shade",
            "text": "Use product photos, color names, and Studio Zeal guidance before publishing the final shade workflow."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Finish the blend",
            "text": "Use Colored Hairline Powder for root touch-ups, sparse areas, regrowth, and transition lines between biological hair and the system."
