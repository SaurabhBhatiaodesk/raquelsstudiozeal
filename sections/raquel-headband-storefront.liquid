      "default": "https://hairlosophy.com/media/catalog/product/cache/6517c62f5899ad6aa0ba23ceb3eeff97/y/o/you_hh_v2.jpg"
    },
    {
      "type": "text",
      "id": "headband_image_alt",
      "label": "Headband image alt text",
