{% comment %}
  Studio Zeal - How It Works
  File: sections/studio-zeal-how-it-works.liquid
{% endcomment %}

<section
  id="studio-zeal-how-{{ section.id }}"
  class="studio-zeal-how"
>
  <div class="page-width studio-zeal-how__container">

    {% if section.settings.heading != blank %}
      <h2 class="studio-zeal-how__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="studio-zeal-how__grid">

        {% for block in section.blocks %}

          <div
            class="
              studio-zeal-how__card
              {% if block.settings.card_style == 'dark' %}
                studio-zeal-how__card--dark
              {% endif %}
            "
            {{ block.shopify_attributes }}
          >

            {% if block.settings.step_label != blank %}
              <div class="studio-zeal-how__step">
                {{ block.settings.step_label }}
              </div>
            {% endif %}

            {% if block.settings.title != blank %}
              <h3 class="studio-zeal-how__title">
                {{ block.settings.title }}
              </h3>
            {% endif %}

            {% if block.settings.description != blank %}
              <div class="studio-zeal-how__description">
                {{ block.settings.description }}
              </div>
            {% endif %}

          </div>

        {% endfor %}

      </div>
    {% endif %}

  </div>
</section>


<style>

  /* ====================================
     SECTION
  ==================================== */

  #studio-zeal-how-{{ section.id }} {
    width: 100%;

    background:
      {{ section.settings.background_color }};

    color:
      {{ section.settings.text_color }};
  }


  #studio-zeal-how-{{ section.id }} *,
  #studio-zeal-how-{{ section.id }} *::before,
  #studio-zeal-how-{{ section.id }} *::after {
    box-sizing: border-box;
  }


  /* ====================================
     CONTAINER
  ==================================== */

  #studio-zeal-how-{{ section.id }}
  .studio-zeal-how__container {

    width: 100%;

    margin: 0 auto;

    padding-top:
      {{ section.settings.padding_top }}px;

    padding-bottom:
      {{ section.settings.padding_bottom }}px;
  }


  /* ====================================
     HEADING
  ==================================== */

  #studio-zeal-how-{{ section.id }}
  .studio-zeal-how__heading {

    margin: 0 0
      {{ section.settings.heading_spacing }}px;

    color:
      {{ section.settings.text_color }};

    font-family:
      "Cormorant Garamond",
      Georgia,
      serif;

    font-size:
      {{ section.settings.heading_size }}px;

    font-weight: 500;

    line-height: 1.1;

    letter-spacing: -0.01em;
  }


  /* ====================================
     GRID
  ==================================== */

  #studio-zeal-how-{{ section.id }}
  .studio-zeal-how__grid {

    display: grid;

    grid-template-columns:
      repeat(
        {{ section.settings.desktop_columns }},
        minmax(0, 1fr)
      );

    gap:
      {{ section.settings.card_gap }}px;
  }


  /* ====================================
     CARD
  ==================================== */

  #studio-zeal-how-{{ section.id }}
  .studio-zeal-how__card {

    min-width: 0;

    padding:
      {{ section.settings.card_padding_top }}px
      {{ section.settings.card_padding_horizontal }}px
      {{ section.settings.card_padding_bottom }}px;

    border:
      1px solid
      {{ section.settings.card_border_color }};

    border-radius:
      {{ section.settings.card_radius }}px;

    background:
      {{ section.settings.card_background }};

    color:
      {{ section.settings.text_color }};

    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }


  {% if section.settings.enable_hover or true %}

    #studio-zeal-how-{{ section.id }}
    .studio-zeal-how__card:hover {

      transform: translateY(-4px);

      background:
        {{ section.settings.dark_card_background }};

      color:
        {{ section.settings.dark_card_text }};

      border-color:
        {{ section.settings.dark_card_background }};

      box-shadow:
        0 16px 38px
        rgba(36, 28, 22, 0.08);
    }


    #studio-zeal-how-{{ section.id }}
    .studio-zeal-how__card:hover
    .studio-zeal-how__step {

      color:
        {{ section.settings.dark_accent_color }};
    }


    #studio-zeal-how-{{ section.id }}
    .studio-zeal-how__card:hover
    .studio-zeal-how__description {

      color:
        {{ section.settings.dark_secondary_text }};
    }

  {% endif %}


  /* ====================================
     DARK CARD
  ==================================== */

  #studio-zeal-how-{{ section.id }}
  .studio-zeal-how__card--dark {

    border-color:
      {{ section.settings.dark_card_background }};

    background:
      {{ section.settings.dark_card_background }};

    color:
      {{ section.settings.dark_card_text }};
  }


  /* ====================================
     STEP LABEL
  ==================================== */

  #studio-zeal-how-{{ section.id }}
  .studio-zeal-how__step {

    margin-bottom: 18px;

    color:
      {{ section.settings.accent_color }};

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size:
      {{ section.settings.step_size }}px;

    font-weight: 500;

    line-height: 1;

    letter-spacing: 0.2em;

    text-transform: uppercase;
  }


  #studio-zeal-how-{{ section.id }}
  .studio-zeal-how__card--dark
  .studio-zeal-how__step {

    color:
      {{ section.settings.dark_accent_color }};
  }


  /* ====================================
     CARD TITLE
  ==================================== */

  #studio-zeal-how-{{ section.id }}
  .studio-zeal-how__title {

    margin: 0 0 10px;

    color: inherit;

    font-family:
      "Cormorant Garamond",
      Georgia,
      serif;

    font-size:
      {{ section.settings.card_title_size }}px;

    font-weight: 500;

    line-height: 1.2;

    letter-spacing: -0.01em;
  }


  /* ====================================
     CARD DESCRIPTION
  ==================================== */

  #studio-zeal-how-{{ section.id }}
  .studio-zeal-how__description {

    color:
      {{ section.settings.secondary_text_color }};

    font-size:
      {{ section.settings.description_size }}px;

    font-weight:400;

    line-height: 1.55;
  }


  #studio-zeal-how-{{ section.id }}
  .studio-zeal-how__description p {

    margin: 0;
  }


  #studio-zeal-how-{{ section.id }}
  .studio-zeal-how__card--dark
  .studio-zeal-how__description {

    color:
      {{ section.settings.dark_secondary_text }};
  }


  /* ====================================
     TABLET
  ==================================== */

  @media screen and (max-width: 990px) {

    #studio-zeal-how-{{ section.id }}
    .studio-zeal-how__container {

      padding-left: 0;
      padding-right: 0;
    }


    #studio-zeal-how-{{ section.id }}
    .studio-zeal-how__grid {

      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }

  }


  /* ====================================
     MOBILE
  ==================================== */

  @media screen and (max-width: 749px) {

    #studio-zeal-how-{{ section.id }}
    .studio-zeal-how__container {

      padding:
        {{ section.settings.mobile_padding_top }}px
        20px
        {{ section.settings.mobile_padding_bottom }}px;
    }


    #studio-zeal-how-{{ section.id }}
    .studio-zeal-how__heading {

      margin-bottom:
        {{ section.settings.mobile_heading_spacing }}px;

      font-size:
        {{ section.settings.mobile_heading_size }}px;
    }


    #studio-zeal-how-{{ section.id }}
    .studio-zeal-how__grid {

      grid-template-columns: 1fr;

      gap:
        {{ section.settings.mobile_card_gap }}px;
    }


    #studio-zeal-how-{{ section.id }}
    .studio-zeal-how__card {

      padding:
        {{ section.settings.card_padding_top }}px
        {{ section.settings.card_padding_horizontal }}px
        {{ section.settings.card_padding_bottom }}px;
    }


    #studio-zeal-how-{{ section.id }}
    .studio-zeal-how__title {

      font-size:
        {{ section.settings.mobile_card_title_size }}px;
    }

  }

</style>


