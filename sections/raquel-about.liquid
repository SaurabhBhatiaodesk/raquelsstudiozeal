{% comment %}
  Studio Zeal - Meet Raquel
  File: sections/studio-zeal-meet-raquel.liquid
{% endcomment %}

<section
  id="studio-zeal-about-{{ section.id }}"
  class="studio-zeal-about"
>
  <div class="page-width studio-zeal-about__container">

    <div class="studio-zeal-about__media">

      {% if section.settings.image != blank %}

        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag:
            class: 'studio-zeal-about__image',
            loading: 'lazy',
            widths: '500, 700, 900, 1200',
            sizes: '(max-width: 749px) 100vw, 440px'
        }}

      {% else %}

        <div class="studio-zeal-about__placeholder">
          {{ 'image' | placeholder_svg_tag }}
        </div>

      {% endif %}

    </div>


    <div class="studio-zeal-about__content">

      {% if section.settings.kicker != blank %}
        <div class="studio-zeal-about__kicker">
          {{ section.settings.kicker }}
        </div>
      {% endif %}


      {% if section.settings.heading != blank %}
        <h2 class="studio-zeal-about__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}


      {% if section.settings.first_text != blank %}
        <div class="studio-zeal-about__text">
          {{ section.settings.first_text }}
        </div>
      {% endif %}


      {% if section.settings.second_text != blank %}
        <div class="studio-zeal-about__text studio-zeal-about__text--last">
          {{ section.settings.second_text }}
        </div>
      {% endif %}


      {% if section.blocks.size > 0 %}

        <div class="studio-zeal-about__stats">

          {% for block in section.blocks %}

            {% if block.type == 'stat' %}

              <div
                class="studio-zeal-about__stat"
                {{ block.shopify_attributes }}
              >

                {% if block.settings.number != blank %}
                  <div class="studio-zeal-about__stat-number">
                    {{ block.settings.number }}
                  </div>
                {% endif %}

                {% if block.settings.label != blank %}
                  <div class="studio-zeal-about__stat-label">
                    {{ block.settings.label }}
                  </div>
                {% endif %}

              </div>

            {% endif %}

          {% endfor %}

        </div>

      {% endif %}

    </div>

  </div>
</section>


<style>

  /* ================================
     SECTION
  ================================= */

  #studio-zeal-about-{{ section.id }} {

    width: 100%;

    background:
      {{ section.settings.background_color }};

    color:
      {{ section.settings.text_color }};
  }


  #studio-zeal-about-{{ section.id }} *,
  #studio-zeal-about-{{ section.id }} *::before,
  #studio-zeal-about-{{ section.id }} *::after {

    box-sizing: border-box;
  }


  /* ================================
     CONTAINER
  ================================= */

  #studio-zeal-about-{{ section.id }}
  .studio-zeal-about__container {

    width: 100%;

    margin: 0 auto;

    padding:
      {{ section.settings.padding_top }}px
      36px
      {{ section.settings.padding_bottom }}px;

    display: grid;

    grid-template-columns:
      {{ section.settings.image_width }}px
      minmax(0, 1fr);

    align-items: center;

    gap:
      {{ section.settings.column_gap }}px;
  }


  /* ================================
     IMAGE
  ================================= */

  #studio-zeal-about-{{ section.id }}
  .studio-zeal-about__media {

    width: 100%;

    overflow: hidden;

    border:
      1px solid
      {{ section.settings.image_border_color }};

    border-radius:
      {{ section.settings.image_radius }}px;

    background: #efe7dc;
  }


  #studio-zeal-about-{{ section.id }}
  .studio-zeal-about__image {

    width: 100%;

    height: auto;

    display: block;

    object-fit: cover;
  }


  #studio-zeal-about-{{ section.id }}
  .studio-zeal-about__placeholder,
  #studio-zeal-about-{{ section.id }}
  .studio-zeal-about__placeholder svg {

    width: 100%;

    display: block;
  }


  /* ================================
     CONTENT
  ================================= */

  #studio-zeal-about-{{ section.id }}
  .studio-zeal-about__content {

    width: 100%;

    max-width:
      {{ section.settings.content_width }}px;
  }


  #studio-zeal-about-{{ section.id }}
  .studio-zeal-about__kicker {

    margin-bottom: 20px;

    color:
      {{ section.settings.accent_color }};

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 10px;

    font-weight: 500;

    line-height: 1;

    letter-spacing: 0.2em;

    text-transform: uppercase;
  }


  /* ================================
     HEADING
  ================================= */

  #studio-zeal-about-{{ section.id }}
  .studio-zeal-about__heading {

    margin: 0 0 18px;

    color:
      {{ section.settings.text_color }};

    font-family:
      "Cormorant Garamond",
      Georgia,
      serif;

    font-size:
      {{ section.settings.heading_size }}px;

    font-weight: 500;

    line-height: 1.12;

    letter-spacing: -0.01em;
  }


  /* ================================
     TEXT
  ================================= */

  #studio-zeal-about-{{ section.id }}
  .studio-zeal-about__text {

    max-width: 520px;

    margin-bottom: 16px;

    color:
      {{ section.settings.secondary_text_color }};

    font-family:
      Karla,
      sans-serif;

    font-size:
      {{ section.settings.description_size }}px;

    font-weight: 300;

    line-height: 1.68;
  }


  #studio-zeal-about-{{ section.id }}
  .studio-zeal-about__text--last {

    margin-bottom: 26px;
  }


  #studio-zeal-about-{{ section.id }}
  .studio-zeal-about__text p {

    margin: 0;
  }


  /* ================================
     STATS
  ================================= */

  #studio-zeal-about-{{ section.id }}
  .studio-zeal-about__stats {

    display: flex;

    align-items: flex-start;

    flex-wrap: wrap;

    gap:
      {{ section.settings.stat_gap }}px;
  }


  #studio-zeal-about-{{ section.id }}
  .studio-zeal-about__stat {

    min-width: 110px;
  }


  #studio-zeal-about-{{ section.id }}
  .studio-zeal-about__stat-number {

    margin-bottom: 6px;

    color:
      {{ section.settings.text_color }};

    font-family:
      "Cormorant Garamond",
      Georgia,
      serif;

    font-size:
      {{ section.settings.stat_number_size }}px;

    font-weight: 500;

    line-height: 1;
  }


  #studio-zeal-about-{{ section.id }}
  .studio-zeal-about__stat-label {

    max-width: 130px;

    color:
      {{ section.settings.secondary_text_color }};

    font-family:
      Karla,
      sans-serif;

    font-size: 13px;

    font-weight: 400;

    line-height: 1.4;
  }


  /* ================================
     TABLET
  ================================= */

  @media screen and (max-width: 990px) {

    #studio-zeal-about-{{ section.id }}
    .studio-zeal-about__container {

      padding-left: 28px;
      padding-right: 28px;

      grid-template-columns:
        minmax(300px, 0.85fr)
        minmax(0, 1fr);

      gap: 40px;
    }


    #studio-zeal-about-{{ section.id }}
    .studio-zeal-about__heading {

      font-size: 36px;
    }


    #studio-zeal-about-{{ section.id }}
    .studio-zeal-about__stats {

      gap: 24px;
    }

  }


  /* ================================
     MOBILE
  ================================= */

  @media screen and (max-width: 749px) {

    #studio-zeal-about-{{ section.id }}
    .studio-zeal-about__container {

      padding:
        {{ section.settings.mobile_padding_top }}px
        20px
        {{ section.settings.mobile_padding_bottom }}px;

      grid-template-columns: 1fr;

      gap: 34px;
    }


    #studio-zeal-about-{{ section.id }}
    .studio-zeal-about__content {

      max-width: 100%;
    }


    #studio-zeal-about-{{ section.id }}
    .studio-zeal-about__heading {

      font-size:
        {{ section.settings.mobile_heading_size }}px;
    }


    #studio-zeal-about-{{ section.id }}
    .studio-zeal-about__text {

      max-width: 100%;

      font-size: 15px;
    }


    #studio-zeal-about-{{ section.id }}
    .studio-zeal-about__stats {

      display: grid;

      grid-template-columns:
        repeat(3, minmax(0, 1fr));

      gap: 18px;
    }


    #studio-zeal-about-{{ section.id }}
    .studio-zeal-about__stat {

      min-width: 0;
    }


    #studio-zeal-about-{{ section.id }}
    .studio-zeal-about__stat-number {

      font-size:
        {{ section.settings.mobile_stat_number_size }}px;
    }


    #studio-zeal-about-{{ section.id }}
    .studio-zeal-about__stat-label {

      font-size: 11.5px;
    }

  }


  @media screen and (max-width: 480px) {

    #studio-zeal-about-{{ section.id }}
    .studio-zeal-about__stats {

      grid-template-columns: 1fr;

      gap: 20px;
    }


    #studio-zeal-about-{{ section.id }}
    .studio-zeal-about__stat {

      padding-bottom: 16px;

      border-bottom:
        1px solid
        {{ section.settings.image_border_color }};
    }


    #studio-zeal-about-{{ section.id }}
    .studio-zeal-about__stat:last-child {

      border-bottom: 0;

      padding-bottom: 0;
    }


    #studio-zeal-about-{{ section.id }}
    .studio-zeal-about__stat-label {

      max-width: none;
    }

  }

</style>


{% schema %}
{
  "name": "Studio Zeal Meet Raquel",
  "tag": "section",
  "class": "studio-zeal-about-section",

  "settings": [

    {
      "type": "header",
      "content": "Image"
    },

    {
      "type": "image_picker",
      "id": "image",
      "label": "Raquel image"
    },

    {
      "type": "range",
      "id": "image_width",
      "min": 300,
      "max": 600,
      "step": 10,
      "unit": "px",
      "label": "Desktop image width",
      "default": 440
    },

    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Image radius",
      "default": 16
    },


    {
      "type": "header",
      "content": "Content"
    },

    {
      "type": "text",
      "id": "kicker",
      "label": "Small heading",
      "default": "MEET RAQUEL"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Nearly 20 years of hands on hairlines"
    },

    {
      "type": "richtext",
      "id": "first_text",
      "label": "First paragraph",
      "default": "<p>Salon Studio Zeal specializes in non-surgical hair solutions for women with thinning hair. Most of my clients have tried extensions, halos and volumizers that add length everywhere except the place they actually notice — the hairline that frames their face.</p>"
    },

    {
      "type": "richtext",
      "id": "second_text",
      "label": "Second paragraph",
      "default": "<p>That is what the Hairlosophy Headband Hairline was made for. Every set I sell is sourced from a professional hair company I trust, and I match it to you myself.</p>"
    },

    {
      "type": "range",
      "id": "content_width",
      "min": 400,
      "max": 800,
      "step": 10,
      "unit": "px",
      "label": "Content max width",
      "default": 620
    },


    {
      "type": "header",
      "content": "Typography"
    },

    {
      "type": "range",
      "id": "heading_size",
      "min": 28,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Desktop heading",
      "default": 40
    },

    {
      "type": "range",
      "id": "mobile_heading_size",
      "min": 26,
      "max": 44,
      "step": 1,
      "unit": "px",
      "label": "Mobile heading",
      "default": 32
    },

    {
      "type": "range",
      "id": "description_size",
      "min": 13,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Paragraph size",
      "default": 17
    },

    {
      "type": "range",
      "id": "stat_number_size",
      "min": 24,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Stat number size",
      "default": 34
    },

    {
      "type": "range",
      "id": "mobile_stat_number_size",
      "min": 22,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Mobile stat number",
      "default": 30
    },


    {
      "type": "header",
      "content": "Layout"
    },

    {
      "type": "range",
      "id": "container_width",
      "min": 1000,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "label": "Container width",
      "default": 1240
    },

    {
      "type": "range",
      "id": "column_gap",
      "min": 20,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Image/content gap",
      "default": 56
    },

    {
      "type": "range",
      "id": "stat_gap",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Stats gap",
      "default": 36
    },


    {
      "type": "header",
      "content": "Spacing"
    },

    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Desktop top padding",
      "default": 84
    },

    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Desktop bottom padding",
      "default": 0
    },

    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Mobile top padding",
      "default": 60
    },

    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Mobile bottom padding",
      "default": 0
    },


    {
      "type": "header",
      "content": "Colors"
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FAF6F0"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Main text",
      "default": "#241C16"
    },

    {
      "type": "color",
      "id": "secondary_text_color",
      "label": "Secondary text",
      "default": "#4A403A"
    },

    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#8C6357"
    },

    {
      "type": "color",
      "id": "image_border_color",
      "label": "Image border",
      "default": "#DED5CC"
    }

  ],


  "blocks": [

    {
      "type": "stat",
      "name": "Stat",

      "settings": [

        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "20"
        },

        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "years behind the chair"
        }

      ]

    }

  ],


  "presets": [

    {
      "name": "Studio Zeal Meet Raquel",

      "blocks": [

        {
          "type": "stat",
          "settings": {
            "number": "20",
            "label": "years behind the chair"
          }
        },

        {
          "type": "stat",
          "settings": {
            "number": "15 min",
            "label": "free color-match call"
          }
        },

        {
          "type": "stat",
          "settings": {
            "number": "100%",
            "label": "Remy human hair"
          }
        }

      ]

    }

  ]

}
{% endschema %}