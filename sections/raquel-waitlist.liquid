<section id="waitlist" class="sz-section sz-waitlist color-{{ section.settings.color_scheme }}" aria-labelledby="WaitlistHeading-{{ section.id }}">
  <div class="sz-organic-lines sz-organic-lines--bottom" aria-hidden="true"></div>
  <div class="sz-wrap sz-waitlist__inner">
    {% if section.settings.kicker != blank %}<p class="sz-eyebrow">{{ section.settings.kicker }}</p>{% endif %}
    <h2 id="WaitlistHeading-{{ section.id }}" class="sz-heading">{{ section.settings.heading }}</h2>
    {% if section.settings.text != blank %}<div class="sz-copy sz-copy--center">{{ section.settings.text }}</div>{% endif %}
    {% form 'customer', class: 'sz-waitlist__form' %}
      <input type="hidden" name="contact[tags]" value="{{ section.settings.tags }}">
      <label class="visually-hidden" for="WaitlistEmail-{{ section.id }}">Email address</label>
      <input id="WaitlistEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email }}" placeholder="{{ section.settings.placeholder }}" autocomplete="email" required {% if form.errors %}aria-invalid="true"{% endif %}>
      <button class="sz-button sz-button--sage" type="submit">{{ section.settings.button_label }}</button>
      {% if form.posted_successfully? %}<p class="sz-waitlist__message" tabindex="-1">{{ section.settings.success_text }}</p>{% elsif form.errors %}<div class="sz-waitlist__message">{{ form.errors | default_errors }}</div>{% endif %}
    {% endform %}
    <p class="sz-waitlist__note">{{ section.settings.note }}</p>
    {% if section.settings.secondary_label != blank %}<a class="sz-waitlist__link" href="{{ section.settings.secondary_link | default: '#products' }}">{{ section.settings.secondary_label }}</a>{% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Studio Zeal waitlist",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-4" },
    { "type": "text", "id": "kicker", "label": "Eyebrow", "default": "Want first access?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The reel brought you here. Stay close." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Get first access to availability, personal shade guidance from Raquel, and launch-only offers straight to your inbox.</p>" },
    { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "Email address" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Join the waitlist" },
    { "type": "text", "id": "tags", "label": "Shopify customer tags", "default": "waitlist,email_signup" },
    { "type": "text", "id": "success_text", "label": "Success text", "default": "You are on the list ✓" },
    { "type": "text", "id": "note", "label": "Note", "default": "No spam. Just product drops, shade help, and Studio Zeal updates." },
    { "type": "text", "id": "secondary_label", "label": "Secondary link label", "default": "Ready now? Shop the full lineup →" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" }
  ],
  "presets": [{ "name": "Studio Zeal waitlist" }]
}
{% endschema %}
