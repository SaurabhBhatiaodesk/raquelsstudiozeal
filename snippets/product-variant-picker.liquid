{% comment %}
  Renders product variant picker.

  Accepts:
  - product
  - block
  - product_form_id
{% endcomment %}

{%- unless product.has_only_default_variant -%}
  <variant-selects
    class="variant-selected"
    id="variant-selects-{{ section.id }}"
    data-section="{{ section.id }}"
    {{ block.shopify_attributes }}
  >
    {%- for option in product.options_with_values -%}
      {%- liquid
        assign swatch_count = option.values | map: 'swatch' | compact | size
        assign picker_type = block.settings.picker_type
        assign option_name_downcase = option.name | downcase
        assign use_shade_image_grid = false

        if swatch_count > 0 and block.settings.swatch_shape != 'none'
          if block.settings.picker_type == 'dropdown'
            assign picker_type = 'swatch_dropdown'
          else
            assign picker_type = 'swatch'
          endif
        endif

        if option.name == 'Shade' and block.settings.picker_type == 'dropdown'
          assign picker_type = 'hairline_swatch'
        endif

        if block.settings.picker_type == 'image_grid'
          assign picker_type = 'hairline_swatch'
          assign use_shade_image_grid = true
        endif

        if product.handle == 'colored-hairline-powder' and option.name == 'Shade'
          assign picker_type = 'powder_swatch'
          assign use_shade_image_grid = false
        endif
      -%}

      {%- if picker_type == 'swatch'
        or picker_type == 'hairline_swatch'
        or picker_type == 'powder_swatch'
      -%}
        <fieldset
          class="js product-form__input product-form__input--swatch{% if picker_type == 'hairline_swatch' %} product-form__input--hairline-swatch{% endif %}{% if picker_type == 'powder_swatch' %} product-form__input--powder-swatch{% endif %}{% if use_shade_image_grid %} h2y-shade-image-grid{% endif %}"
        >
          <legend class="form__label">
            {%- if picker_type == 'hairline_swatch'
              or picker_type == 'powder_swatch'
            -%}
              <span>
                {{ option.name }} - {{ option.values.size }} options
              </span>
            {%- else -%}
              {{ option.name }}:
            {%- endif -%}

            <span data-selected-value>
              {{- option.selected_value -}}
            </span>
          </legend>

          {% render 'product-variant-options',
            product: product,
            option: option,
            block: block,
            picker_type: picker_type
          %}
        </fieldset>

      {%- elsif picker_type == 'button' -%}
        <fieldset class="js product-form__input product-form__input--pill">
          <legend class="form__label">
            {{ option.name }}
          </legend>

          {% render 'product-variant-options',
            product: product,
            option: option,
            block: block,
            picker_type: picker_type
          %}
        </fieldset>

      {%- else -%}
        <div class="product-form__input product-form__input--dropdown">
          <label
            class="form__label"
            for="Option-{{ section.id }}-{{ forloop.index0 }}"
          >
            {{ option.name }}
          </label>

          <div class="select">
            {%- if picker_type == 'swatch_dropdown' -%}
              <span data-selected-value class="dropdown-swatch">
                {% render 'swatch',
                  swatch: option.selected_value.swatch,
                  shape: block.settings.swatch_shape
                %}
              </span>
            {%- endif -%}

            <select
              id="Option-{{ section.id }}-{{ forloop.index0 }}"
              class="select__select"
              name="options[{{ option.name | escape }}]"
              form="{{ product_form_id }}"
            >
              {% render 'product-variant-options',
                product: product,
                option: option,
                block: block,
                picker_type: picker_type
              %}
            </select>

            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}

    <script type="application/json" data-selected-variant>
      {{ product.selected_or_first_available_variant | json }}
    </script>
  </variant-selects>
{%- endunless -%}
<style>
  .h2y-shade-image-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(75px, 1fr));
    gap: 12px 8px;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    padding: 0;
    border: 0;
    margin-bottom: 20px;
  }

  .h2y-shade-image-grid > legend.form__label {
    float: none;
    width: 100%;
    padding: 0 0 12px;
    margin: 0;
  }

  .h2y-shade-image-grid
    > legend.form__label
    [data-selected-value] {
    float: right;
    margin-left: 12px;
  }

  .h2y-shade-image-grid
    > input[type="radio"].hairline-swatch__input {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .h2y-shade-image-grid
    > input[type="radio"]
    + label.hairline-swatch__label {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    gap: 6px;
    width: 100%;
    min-width: 0;
    height: auto;
    padding: 0;
    margin: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: inherit;
    box-shadow: none;
    text-align: center;
    cursor: pointer;
  }

  .h2y-shade-image-grid .hairline-swatch__media {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.18);
    border-radius: 7px;
    background: transparent;
    box-sizing: border-box;
  }

  .h2y-shade-image-grid .hairline-swatch__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .h2y-shade-image-grid .hairline-swatch__media .swatch {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    border: 0;
    border-radius: 0;
  }

  .h2y-shade-image-grid .hairline-swatch__name {
    display: block;
    font-size: 10px;
    line-height: 1.3;
    letter-spacing: 0;
    overflow-wrap: anywhere;
  }

  .h2y-shade-image-grid .hairline-swatch__fallback {
    font-size: 20px;
    line-height: 1;
  }

  .h2y-shade-image-grid
    > input[type="radio"]:checked
    + label
    .hairline-swatch__media {
    border-color: currentColor;
    box-shadow: inset 0 0 0 2px currentColor;
  }

  .h2y-shade-image-grid
    > input[type="radio"]:focus-visible
    + label {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .h2y-shade-image-grid
    > input[type="radio"].visually-disabled
    + label
    .hairline-swatch__media {
    opacity: 0.45;
  }

  .h2y-shade-image-grid
    > input[type="radio"].visually-disabled
    + label
    .hairline-swatch__name {
    text-decoration: line-through;
  }
</style>