,"stat_HGn9k6"],"name":"Studio Zeal Meet Raquel","settings":{"image":"shopify:\/\/shop_images\/9c3a865c-228d-4864-96c4-d69d10fccb41.webp","image_width":440,"image_radius":16,"kicker":"MEET RAQUEL","heading":"Nearly 20 years of hands on hairlines","first_text":"<p>Salon Studio Zeal specializes in non-surgical hair solutions for women with thinning hair. Most of my clients have tried extensions, halos and volumizers that add length everywhere except the place they actually notice — the hairline that frames their face.<\/p>","second_text":"<p>That is what the Hairlosophy Headband Hairline was made for. Every set I sell is sourced from a professional hair company I trust, and I match it to you myself.<\/p>","content_width":620,"heading_size":40,"mobile_heading_size":32,"description_size":17,"stat_number_size":34,"mobile_stat_number_size":30,"container_width":1240,"column_gap":56,"stat_gap":36,"padding_top":84,"padding_bottom":64,"mobile_padding_top":60,"mobile_padding_bottom":36,"background_color":"#faf6f0","text_color":"#241c16","secondary_text_color":"#4a403a","accent_color":"#8c6357","image_border_color":"#ded5cc"}},"studio_zeal_testimonials_K6qCW7":{"type":"studio-zeal-testimonials","blocks":{"testimonial_ziKFYd":{"type":"testimonial","settings":{"quote":"<p>I stopped parting my hair on the side to hide it. First time in years.<\/p>","author":"Client, headband hairline"}},"testimonial_nwX8gB":{"type":"testimonial","settings":{"quote":"<p>The call sold me. She told me what would not work for my hair, not just what to buy.<\/p>","author":"Consult, then fitting"}},"testimonial_c4i7yi":{"type":"testimonial","settings":{"quote":"<p>I use the powder on my roots between color appointments. Did not expect that.<\/p>","author":"Powder customer"}}},"block_order":["testimonial_ziKFYd","testimonial_nwX8gB","testimonial_c4i7yi"],"name":"Studio Zeal Testimonials","settings":{"heading":"","subheading":"","desktop_columns":3,"card_gap":22,"mobile_card_gap":16,"card_padding":30,"mobile_card_padding":24,"card_radius":14,"show_quote_mark":false,"enable_hover":false,"heading_size":38,"mobile_heading_size":32,"quote_size":18,"mobile_quote_size":18,"author_size":13,"heading_spacing":30,"padding_top":0,"padding_bottom":0,"mobile_padding_top":0,"mobile_padding_bottom":0,"show_note":true,"note":"","background_color":"#faf6f0","text_color":"#241c16","secondary_text_color":"#5a4e45","accent_color":"#8c6357","card_background":"#f3ede4","card_border_color":"#e3dad1","note_color":"#9a8b7e"}},"raquel_faq_XR6TVK":{"type":"raquel-faq","blocks":{"faq_NwKEUT":{"type":"faq","settings":{"question":"Will it look obvious?","answer":"<p>The lace is hand-tied and sits flat under a headband, and we blend the part with hairline powder at your fitting, or walk you through it on video if you are ordering from out of state. Most clients wear theirs to work the same day.<\/p>","open_by_default":true}},"faq_Nyq6aP":{"type":"faq","settings":{"question":"Why do I need a consult before buying?","answer":"<p>Color is the whole game at this price. Fifteen minutes on video saves a return, and it tells us whether a hairline, a topper or just the powder is right for you.<\/p>","open_by_default":false}},"faq_wjxPhp":{"type":"faq","settings":{"question":"Does it come in curly or wavy?","answer":"<p>It arrives straight and can be permed to match your texture. We talk through that on the call.<\/p>","open_by_default":false}},"faq_7yDCYb":{"type":"faq","settings":{"question":"How long does a set last?","answer":"<p>With the aftercare we show you, a Remy set holds its color and shine for months of regular wear and tangles far less than synthetic alternatives.<\/p>","open_by_default":false}}},"block_order":["faq_NwKEUT","faq_Nyq6aP","faq_wjxPhp","faq_7yDCYb"],"name":"Studio Zeal FAQ Dev","settings":{"heading":"Questions we get<br>on every call"}},"studio_zeal_final_cta_3TfE8R":{"type":"studio-zeal-final-cta","name":"Studio Zeal Final CTA","settings":{"heading":"Let's look at your hairline together","text":"<p>Fifteen minutes, free, no pressure to buy. Pick a time that works and Raquel will call you.<\/p>","primary_button_label":"Book now","primary_button_link":"https:\/\/raquelviara.glossgenius.com\/book?service_token=1000f-0188dc5c-56f6-4b0e-8921-c0ab0dc968fd","secondary_button_label":"Get the guide instead","secondary_button_link":"https:\/\/raquelsstudiozeal.com\/#shopify-section-template--20926398300296__studio_zeal_pricing_guide_NKedwh","background_color":"#efe4d6","heading_color":"#241c16","text_color":"#4a403a","primary_button_bg":"#241c16","primary_button_text":"#faf6f0","primary_button_hover_bg":"#3d2e24","secondary_button_text":"#241c16","secondary_button_hover_border":"#241c16"}}},"order":["studio_zeal_hero_74pCkX","raquel_marquee_UKz6Uh","studio_zeal_social_reels_wmnJiC","studio_zeal_results_tcMq36","studio_zeal_how_it_works_W8XbEP","studio_zeal_pricing_guide_NKedwh","raquel_about_WaRL7V","studio_zeal_testimonials_K6qCW7","raquel_faq_XR6TVK","studio_zeal_final_cta_3TfE8R"]}